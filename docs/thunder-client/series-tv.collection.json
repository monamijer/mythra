{
  "info": {
    "name": "Series TV API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Démonstration dans l'ordre des dossiers. Après chaque connexion, copiez le token dans tokenAdmin ou tokenAlice ; après chaque création, copiez l'id dans la variable correspondante (aliceId, serieId, saisonId, episodeId)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenAlice",
      "value": ""
    },
    {
      "key": "adminId",
      "value": "1"
    },
    {
      "key": "aliceId",
      "value": ""
    },
    {
      "key": "serieId",
      "value": ""
    },
    {
      "key": "saisonId",
      "value": ""
    },
    {
      "key": "episodeId",
      "value": ""
    },
    {
      "key": "tmdbId",
      "value": "1396"
    }
  ],
  "item": [
    {
      "name": "1 - Authentification",
      "item": [
        {
          "name": "Inscription (alice)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/inscription",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "inscription"
              ]
            },
            "description": "Résultat attendu : 201, compte EN_ATTENTE, pas de token. Notez l'id renvoyé dans la variable aliceId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pseudo\": \"alice\",\n  \"email\": \"alice@example.com\",\n  \"motDePasse\": \"motdepasse123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Inscription invalide",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/inscription",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "inscription"
              ]
            },
            "description": "Résultat attendu : 400 avec le détail des champs invalides",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pseudo\": \"\",\n  \"email\": \"pas-un-email\",\n  \"motDePasse\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Connexion d'alice avant approbation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/connexion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "connexion"
              ]
            },
            "description": "Résultat attendu : 403, message : compte en attente d'approbation",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"motDePasse\": \"motdepasse123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Connexion avec un mauvais mot de passe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/connexion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "connexion"
              ]
            },
            "description": "Résultat attendu : 401, email ou mot de passe incorrect",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"motDePasse\": \"faux-mot-de-passe\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Connexion de l'administrateur",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/connexion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "connexion"
              ]
            },
            "description": "Résultat attendu : 200 avec un token. Copiez-le dans la variable tokenAdmin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@seriestv.local\",\n  \"motDePasse\": \"Admin1234!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2 - Administration",
      "item": [
        {
          "name": "Lister les utilisateurs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/utilisateurs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "utilisateurs"
              ]
            },
            "description": "Résultat attendu : 200"
          }
        },
        {
          "name": "Lister les comptes en attente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/utilisateurs?statut=EN_ATTENTE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "utilisateurs"
              ],
              "query": [
                {
                  "key": "statut",
                  "value": "EN_ATTENTE"
                }
              ]
            },
            "description": "Résultat attendu : 200"
          }
        },
        {
          "name": "Statistiques des comptes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
