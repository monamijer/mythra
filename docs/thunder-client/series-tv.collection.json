            "url": {
              "raw": "{{baseUrl}}/api/admin/utilisateurs/statistiques",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "utilisateurs",
                "statistiques"
              ]
            },
            "description": "Résultat attendu : 200"
          }
        },
        {
          "name": "Approuver alice",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/utilisateurs/{{aliceId}}/approuver",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "utilisateurs",
                "{{aliceId}}",
                "approuver"
              ]
            },
            "description": "Résultat attendu : 200, statut APPROUVE"
          }
        },
        {
          "name": "Connexion d'alice après approbation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/connexion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "connexion"
              ]
            },
            "description": "Résultat attendu : 200 avec un token. Copiez-le dans la variable tokenAlice.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"motDePasse\": \"motdepasse123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
