+# --- Local configuration ---
+# Optional .env file at the project root (KEY=value lines, ignored by Git, see
+# .env.example). Real environment variables work too and take precedence.
+spring.config.import=optional:file:.env[.properties]
+
+# --- MySQL / MariaDB (XAMPP) ---
+# The database itself is created on first start (createDatabaseIfNotExist=true);
+# its tables are then generated by Hibernate from the entities.
+spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/series_tv_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&serverVersion=10.4.32}
+spring.datasource.username=${DB_USERNAME:root}
+spring.datasource.password=${DB_PASSWORD:}
 spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
 
 # --- JPA / Hibernate ---
-# Hibernate will just validate/complete it). Never use 'update' in production.
+# update: Hibernate creates the missing tables and columns from the entities.
+# Convenient for this project, not recommended in production.
