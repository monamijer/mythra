# Copy this file to .env and adapt the values. The .env file is ignored by Git.

# Database (XAMPP default: user root, empty password)
DB_USERNAME=root
DB_PASSWORD=

# TMDB API key (v3), created at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# Secret used to sign the JWT tokens, written in Base64 (at least 32 bytes).
# Generate one with:  openssl rand -base64 48
# While this line stays commented out, a development-only secret is used.
# JWT_SECRET=

# First administrator, created at startup when the database has none yet
ADMIN_EMAIL=admin@seriestv.local
ADMIN_PSEUDO=admin
ADMIN_PASSWORD=choose-a-strong-password
