# Copy this file to .env and adapt the values. The .env file is ignored by Git.

# Database (XAMPP default: user root, empty password)
DB_USERNAME=root
DB_PASSWORD=

# TMDB API key (v3), created at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# Secret used to sign the JWT tokens (at least 32 characters)
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-characters
